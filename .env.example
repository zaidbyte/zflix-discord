# Copy this file to .env and fill in real values.

# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# From https://console.groq.com/keys (free tier)
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated guild (server) IDs the bot is allowed to respond in.
# Leave empty to allow all servers + DMs.
ALLOWED_GUILD_IDS=1501443351889707049

# Optional overrides
GROQ_MODEL=llama-3.3-70b-versatile
MAX_REPLY_DEPTH=12
MAX_TOKENS=1024
TEMPERATURE=0.5
